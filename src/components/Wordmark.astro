---
// Wordmark.astro: the club's logo, the word CIVIC drawn as five shapes, with "AI CLUB" beneath.
// Generated by scripts/build-wordmark.mjs from Host Grotesk Light (OFL-1.1). Do not edit by hand: change the script and run "npm run wordmark".
//
// Each letter is its own <path> with a data-letter number (0 to 4, left to right), so the motion
// code in src/scripts/motion/ can move letters one at a time:
//   - variant="hero":   the huge logo at the top of the home page. The letters rise from both
//                       ends (modules/wordmark.js) and drift apart as you scroll.
//   - variant="footer": the full-width logo at the bottom of every page. It rebuilds from the
//                       center out when the footer comes into view (modules/footer.js).
//   - variant="small":  the little logo the header swaps in (modules/header.js).
//   - variant="plain":  no motion at all (share images, the style guide).
// Screen readers hear one name, "Civic AI Club", because the small "AI CLUB" line is hidden
// from them (it would otherwise be read twice).
interface Props {
  variant?: 'hero' | 'footer' | 'small' | 'plain';
  // Show the small mono "AI CLUB" line under the last C.
  lockup?: boolean;
  // Set to true when the logo sits next to text that already says "Civic AI Club", so screen
  // readers do not hear the name twice.
  decorative?: boolean;
  class?: string;
}
const { variant = 'plain', lockup = true, decorative = false, class: className } = Astro.props;
---

<div class:list={['wordmark', `wordmark--${variant}`, className]} data-wordmark={variant}>
  <svg
    class="wordmark__svg"
    viewBox="37 -712 2346 724"
    role={decorative ? undefined : 'img'}
    aria-label={decorative ? undefined : 'Civic AI Club'}
    aria-hidden={decorative ? 'true' : undefined}
    focusable="false"
  >
    <path data-letter="0" data-char="C" data-x="0" data-w="623" d="M369 12L369 12Q267 12 192.5 -33.5Q118 -79 77.5 -160.5Q37 -242 37 -350L37 -350Q37 -458 77.5 -539.5Q118 -621 192.5 -666.5Q267 -712 369 -712L369 -712Q488 -712 561 -656.5Q634 -601 656 -500L656 -500L578 -500Q562 -568 510 -609.5Q458 -651 369 -651L369 -651Q291 -651 232.5 -615Q174 -579 141.5 -511.5Q109 -444 109 -350L109 -350Q109 -256 141.5 -188.5Q174 -121 232.5 -85Q291 -49 369 -49L369 -49Q458 -49 510.5 -90Q563 -131 582 -207L582 -207L660 -207Q636 -101 562 -44.5Q488 12 369 12" />
    <path data-letter="1" data-char="I" data-x="710" data-w="70" d="M817 0L747 0L747 -700L817 -700L817 0" />
    <path data-letter="2" data-char="V" data-x="872" data-w="610" d="M1254 0L1174 0L909 -700L985 -700L1214 -76L1445 -700L1519 -700L1254 0" />
    <path data-letter="3" data-char="I" data-x="1574" data-w="70" d="M1681 0L1611 0L1611 -700L1681 -700L1681 0" />
    <path data-letter="4" data-char="C" data-x="1723" data-w="623" d="M2092 12L2092 12Q1990 12 1915.5 -33.5Q1841 -79 1800.5 -160.5Q1760 -242 1760 -350L1760 -350Q1760 -458 1800.5 -539.5Q1841 -621 1915.5 -666.5Q1990 -712 2092 -712L2092 -712Q2211 -712 2284 -656.5Q2357 -601 2379 -500L2379 -500L2301 -500Q2285 -568 2233 -609.5Q2181 -651 2092 -651L2092 -651Q2014 -651 1955.5 -615Q1897 -579 1864.5 -511.5Q1832 -444 1832 -350L1832 -350Q1832 -256 1864.5 -188.5Q1897 -121 1955.5 -85Q2014 -49 2092 -49L2092 -49Q2181 -49 2233.5 -90Q2286 -131 2305 -207L2305 -207L2383 -207Q2359 -101 2285 -44.5Q2211 12 2092 12" />
  </svg>
  {lockup && <span class="wordmark__lockup" aria-hidden="true">AI CLUB</span>}
</div>

<style>
  .wordmark {
    display: block;
    width: 100%;
    color: inherit;
  }
  .wordmark__svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: hidden;
    fill: currentColor;
  }
  .wordmark__lockup {
    display: block;
    margin-top: 0.6em;
    text-align: right;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
    line-height: 1;
  }
  .wordmark--hero .wordmark__lockup {
    font-size: clamp(11px, 0.9vw, 15px);
  }
  .wordmark--small {
    width: auto;
  }
  .wordmark--small .wordmark__svg {
    width: auto;
    height: 0.95em;
  }
</style>
