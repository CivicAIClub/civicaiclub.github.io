---
// DownTheRoad.astro: "Down the road" (section 6 of the home page), the first paper section.
//
// It lists the local organizations the club is talking to (seven, for now). Each row shows who
// it is and where, one plain line about them, and where things stand: "In progress" (a project
// is under way: the crimson "in progress" dot and a short stage line, like "Discovery complete.")
// or "Discovery pending" (no dot and no stage line). The page turns from ink to paper at this
// section's top edge, with no fade.
// Open school cases without a page yet (Case E) are not repeated here: they already stand in
// the docket above, as an outlined letter marked "In progress".
//
// Rules for this section: each organization gets a name, a place, one plain line, and a status
// of "In progress" or "Discovery pending". No logos, no AI words, no contact names, and no
// details of how they run.
//
// Where the facts come from: src/data/clients.json (the organizations).
// Motion: the heading and each row's text rise line by line (data-reveal, M1) and each row's
// divider draws itself (Divider, M2).
import Divider from '../Divider.astro';
import clients from '../../data/clients.json';

// A place never breaks in the middle of a name: the spaces inside each name ("The Vanilla Bean
// Café", "Pomfret Center") become no-break spaces, so a long list of places wraps only between
// names, after a comma or around "and".
const keepNamesTogether = (place: string) =>
  place
    .split(/(, | and )/)
    .map((piece) => (piece === ', ' || piece === ' and ' ? piece : piece.replace(/ /g, '\u00a0')))
    .join('');

// One row per organization, in the order clients.json lists them. "stage" is only there for
// an organization with a project under way.
const rows = clients.items.map((client: { name: string; place: string; line: string; status: string; stage?: string }) => ({
  name: client.name,
  place: keepNamesTogether(client.place),
  line: client.line,
  status: client.status,
  stage: client.stage,
  // Only "In progress" gets the crimson dot (it means a project is under way).
  inProgress: client.status === 'In progress',
}));
---

<section class="road theme-paper" aria-labelledby="road-title">
  <div class="grid road__head">
    <h2 id="road-title" class="road__title t-statement" data-reveal="lines">Same playbook, off the hilltop.</h2>
  </div>

  <ul class="road__list">
    {
      rows.map((row) => (
        <li class="road__row grid">
          <Divider class="road__rule" />
          <p class="road__name t-label" data-reveal="lines">
            {row.name}
            {/* The place sits on its own line under the name; screen readers hear "Name, place". */}
            {row.place && <span class="road__place t-secondary"><span class="sr-only">, </span>{row.place}</span>}
          </p>
          <p class="road__line t-label" data-reveal="lines">
            {row.line}
          </p>
          <div class="road__status">
            <p class="t-mono">
              {row.inProgress && <span class="status-dot" aria-hidden="true" />}
              {row.status}
            </p>
            {row.stage && (
              <p class="road__stage t-ui" data-reveal="lines">
                {row.stage}
              </p>
            )}
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .road {
    padding-block: var(--space-section) clamp(80px, 9vw, 140px);
  }
  .road__title {
    grid-column: 1 / -1;
    text-indent: calc((100% + var(--gutter)) * var(--statement-indent) / var(--cols));
  }
  .road__list {
    margin-top: clamp(56px, 7vw, 104px);
  }
  .road__row {
    row-gap: 18px;
    padding-bottom: clamp(28px, 3vw, 40px);
  }
  .road__row :global(.road__rule) {
    grid-column: 1 / -1;
  }
  .road__name {
    grid-column: 1 / span 4;
  }
  .road__place {
    display: block;
  }
  .road__line {
    grid-column: 5 / span 5;
    max-width: 28ch;
  }
  .road__status {
    grid-column: 10 / -1;
    display: grid;
    align-content: start;
    gap: 8px;
  }
  .road__stage {
    color: var(--text-2);
    font-weight: var(--fw-light);
  }
  @media (max-width: 1023px) {
    .road__name {
      grid-column: 1 / span 3;
    }
    .road__line {
      grid-column: 4 / span 3;
    }
    .road__status {
      grid-column: 7 / -1;
    }
  }
  @media (max-width: 767px) {
    .road__row {
      row-gap: 10px;
    }
    .road__name,
    .road__line {
      grid-column: 1 / -1;
    }
    .road__status {
      grid-column: 1 / -1;
      margin-top: 6px;
    }
  }
</style>
