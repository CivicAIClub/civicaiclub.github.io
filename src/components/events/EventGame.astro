---
// EventGame.astro: the closing game's rules, under its row in the program (chapter 04, The Final
// Round). The chapter row itself carries id="final-round", so "How it worked" links land here.
//
// It shows, on columns 3 to 12:
//   - the game's categories on one mono line ("Countries with four letters · ..."),
//   - one ruled row per round: "Round 1", its name ("Pure recall") and its rule ("No phones, no
//     AI."). Laptops put the three side by side; tablets put the rule under the name,
//   - the question the game asked at the end, at statement size.
// Phones: everything across the six columns.
// Motion: the rules draw (M2) and every text rises (M1), the rounds 0.06 s apart.
import Divider from '../Divider.astro';

interface Props {
  game: { categories: string[]; rounds: { title: string; rule: string }[]; question: string };
}
const { game } = Astro.props;
---

<div class="game">
  <p class="game__cats t-mono" data-reveal="lines">{game.categories.join(' · ')}</p>

  <ol class="game__rounds">
    {
      game.rounds.map((round, i) => (
        <li class="game__round">
          <Divider class="game__rule" />
          <p class="game__no t-mono" data-reveal="lines" data-reveal-delay={i * 0.06}>
            Round {i + 1}
          </p>
          <p class="game__title" data-reveal="lines" data-reveal-delay={i * 0.06 + 0.04}>
            {round.title}
          </p>
          <p class="game__rule-text t-label" data-reveal="lines" data-reveal-delay={i * 0.06 + 0.08}>
            {round.rule}
          </p>
        </li>
      ))
    }
  </ol>

  <p class="game__question t-statement" data-reveal="lines">{game.question}</p>
</div>

<style>
  .game {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    margin-top: clamp(24px, 3vw, 40px);
  }
  .game__cats {
    grid-column: 3 / -1;
    color: var(--text-2);
  }

  /* The rounds reuse the page's columns ("subgrid"). Inside a round, column numbers count from
     the round's own first column (page column 3): 1 to 2 is "Round 1", 3 to 6 the name, 7 to 10
     the rule. */
  .game__rounds {
    grid-column: 3 / -1;
    display: grid;
    grid-template-columns: subgrid;
    margin-top: 32px;
  }
  .game__round {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: baseline;
    row-gap: 14px;
    padding-bottom: 24px;
  }
  .game__round :global(.game__rule) {
    grid-column: 1 / -1;
  }
  .game__no {
    grid-column: 1 / span 2;
    color: var(--text-2);
  }
  .game__title {
    grid-column: 3 / span 4;
    font-size: var(--fs-name);
    font-weight: var(--fw-light);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .game__rule-text {
    grid-column: 7 / -1;
  }

  .game__question {
    grid-column: 3 / -1;
    margin-top: clamp(40px, 5vw, 72px);
  }

  /* Tablets: the rule goes under the round's name. */
  @media (max-width: 1023px) {
    .game__rule-text {
      grid-column: 3 / -1;
      color: var(--text-2);
    }
  }

  /* Phones: everything across the six columns. */
  @media (max-width: 767px) {
    .game__cats,
    .game__rounds,
    .game__question {
      grid-column: 1 / -1;
    }
    .game__no,
    .game__title,
    .game__rule-text {
      grid-column: 1 / -1;
    }
    .game__round {
      row-gap: 10px;
    }
  }
</style>
