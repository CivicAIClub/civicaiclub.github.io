---
// RollLink.astro: a small text link whose letters roll on hover, like the header's "Cases".
//
// Two motions work together here:
//   - M6 (character roll): with motion on, hovering sends the letters up and out one after
//     another, and the second phrase rolls up in their place. The second phrase is the
//     "second" prop; leave it out and the label rolls into itself. This part is done by
//     src/scripts/motion/modules/roll.js, driven by the data-roll attribute.
//   - M8 (underline): pure CSS. A normal link draws an underline in from the left on hover.
//     With underline={true} the link always has a line; on hover that line wipes out to the
//     right and a new one draws in from the left 0.15s later.
// With motion off, the second phrase is never shown and the link just gets its underline.
interface Props {
  href: string;
  label: string;
  second?: string;
  // Marks the link for the page you are on (dimmed, and announced as "current page").
  current?: boolean;
  underline?: boolean;
  external?: boolean;
  cursor?: string;
  class?: string;
}
const {
  href,
  label,
  second,
  current = false,
  underline = false,
  external = false,
  cursor,
  class: className,
} = Astro.props;
---

<a
  href={href}
  class:list={['roll-link', 'roll', { 'roll-link--underline': underline, 'is-current': current }, className]}
  aria-current={current ? 'page' : undefined}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  data-roll={second ?? label}
  data-cursor={cursor}
>
  <span class="roll__stack">
    <span class="roll__a">{label}</span>
    <span class="roll__b" aria-hidden="true">{second ?? label}</span>
  </span>
  {external && <span class="sr-only"> (opens in a new tab)</span>}
</a>

<style>
  .roll-link {
    position: relative;
    display: inline-block;
    padding-block: 4px;
  }
  /* Touch screens: a taller tap area (at least 24px even for small mono links). The extra
     padding is cancelled out by a negative margin, so nothing around the link moves. */
  @media (pointer: coarse) {
    .roll-link {
      padding-block: 12px;
      margin-block: -8px;
    }
  }
  /* The link for the page you are on is dimmed. 60% (not less) keeps 14px text readable at
     4.5:1 or better over both paper and ink, through the header's difference blend. */
  .roll-link.is-current {
    opacity: 0.6;
  }
  /* Two lines for the underline hand-off: ::before is the line already there, ::after the new one. */
  .roll-link::before,
  .roll-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform var(--dur-underline) var(--ease-underline);
  }
  .roll-link--underline::before {
    transform: scaleX(1);
    transform-origin: 100% 50%;
  }
  @media (hover: hover) {
    .roll-link:hover::after,
    .roll-link:focus-visible::after {
      transform: scaleX(1);
    }
    .roll-link--underline:hover::before,
    .roll-link--underline:focus-visible::before {
      transform: scaleX(0);
    }
    .roll-link--underline:hover::after,
    .roll-link--underline:focus-visible::after {
      transition-delay: 0.15s;
    }
  }
</style>
