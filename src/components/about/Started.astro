---
// about/Started.astro: "How it started". Section 9 of 10 on the About page.
//
// What it shows:
//   1. The club photo, in black and white, across the whole width of the window, captioned
//      "The first official club meeting, November 2025." (the photo is approved for this page;
//      see src/data/about.json).
//   2. The statement "From one meeting to eleven repositories."
//   3. A strip of cards, one per moment in the club's short history (src/data/timeline.json):
//      the month, the year and one line each.
//   4. Two black-and-white photos from AI Literacy Week (May 2026), a large one (the Future of AI
//      talk) and a small one (the audience) side by side, with one line about the event and a
//      link to its page. Their ids and the event's slug are in src/data/about.json ("event").
//      If that event isn't public (or its slug is mistyped), this part is left out, so the page
//      never links to an event page that doesn't exist. The line "Six months after that first
//      meeting" depends on the event's month (see the note at the top of the event's file).
//
// Motion (src/scripts/motion/modules/about-started.js):
//   - Each photo opens downward (its window grows from the top edge) over 1.8 seconds while the
//     picture inside slides down into place from half its height above (data-about-open).
//   - The cards flip up into place one after another, turning from a tilt as they rise, then the
//     strip drifts slowly to the left, round and round. It stops while the pointer is over it,
//     can be dragged sideways, and has a Pause button (data-about-strip).
// Without motion the strip is a plain row that scrolls sideways (with a trackpad, a swipe, or
// the arrow keys once it has keyboard focus), and the photos are simply there.
import Photo from '../Photo.astro';
import Statement from '../Statement.astro';
import Divider from '../Divider.astro';
import ArrowLink from '../ArrowLink.astro';
import about from '../../data/about.json';
import timeline from '../../data/timeline.json';
import { eventUrl, getPublicEvents } from '../../lib/events';

// Cards 3 and 6 are ink-colored, to give the strip a rhythm. (Change the numbers to move them.)
const inkCards = new Set([2, 5]);

// Split "Nov 2025" into the month ("Nov") and the year ("2025") for the card's two sizes.
const cards = timeline.items.map((item, i) => {
  const [month, year] = item.label.split(' ');
  return { ...item, month, year, index: String(i + 1).padStart(2, '0'), ink: inkCards.has(i) };
});

// The event photos under the strip: which event they link to, and the two photo ids.
const event = about.event;
// That event's entry, only if it is public (otherwise the photos and the link are left out).
const eventEntry = (await getPublicEvents()).find((entry) => entry.data.slug === event.slug);
---

<section class="started theme-paper" aria-labelledby="started-title">
  <figure class="started__photo">
    <div class="started__window" data-about-open>
      <div class="started__inner" data-about-open-inner>
        <Photo
          id={about.media.photo}
          tone="bw"
          caption={false}
          sizes="100vw"
          bare
          class="started__img"
        />
      </div>
    </div>
    <figcaption class="started__caption grid">
      <span class="started__caption-text t-label" data-reveal="lines">The first official club meeting, November 2025.</span>
    </figcaption>
  </figure>

  <div class="started__head grid">
    <Statement as="h2" id="started-title" class="started__title" indent={false}>
      From one meeting to eleven repositories.
    </Statement>
  </div>

  <div class="strip" data-about-strip>
    <div class="strip__bar grid">
      <Divider class="strip__rule" />
      <p class="strip__label t-label" data-reveal="lines">How it started</p>
      <button type="button" class="strip__toggle t-mono" data-about-strip-toggle hidden>
        <span data-about-strip-toggle-label>Pause</span><span class="sr-only"> the moving timeline</span>
      </button>
    </div>
    <div
      class="strip__viewport"
      tabindex="0"
      role="region"
      aria-label="The club’s timeline, November 2025 to September 2026"
      data-about-strip-viewport
      data-cursor="Drag"
    >
      <ol class="strip__track" data-about-strip-track>
        {
          cards.map((card) => (
            <li class:list={['card', { 'card--ink theme-ink': card.ink }]} data-about-strip-card>
              <p class="card__top">
                <span class="card__month">{card.month}</span>
                <span class="card__year t-mono">{card.year}</span>
              </p>
              <p class="card__index t-mono" aria-hidden="true">
                ({card.index})
              </p>
              <p class="card__text">{card.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <!-- 4. Six months on: two photos from AI Literacy Week, in black and white like the club photo
       above, a large one and a small one (both 3:2), bottoms level. Each opens downward like the club photo
       (data-about-open). The link goes to the event's own page. -->
  {
    eventEntry && (
      <div class="started__event grid">
        <div class="started__event-frame started__event-frame--wide" data-about-open>
          <div class="started__inner" data-about-open-inner>
            <Photo
              id={event.media.wide}
              tone="bw"
              bare
              caption={false}
              sizes="(min-width: 1024px) 55vw, 100vw"
              class="started__img"
            />
          </div>
        </div>
        <div class="started__event-frame started__event-frame--small" data-about-open>
          <div class="started__inner" data-about-open-inner>
            <Photo
              id={event.media.small}
              tone="bw"
              bare
              caption={false}
              sizes="(min-width: 1024px) 31vw, 60vw"
              class="started__img"
            />
          </div>
        </div>
        <p class="started__event-caption t-label" data-reveal="lines">
          Six months after that first meeting, the club ran AI Literacy Week for the whole school.
        </p>
        <p class="started__event-link t-label">
          {/* Screen readers hear "See the event, AI Literacy Week": the words around the link */}
          {/* don't name the event, and the visible words still come first. */}
          <ArrowLink href={eventUrl(event.slug)}>See the event<span class="sr-only">, {eventEntry.data.title}</span></ArrowLink>
        </p>
      </div>
    )
  }
</section>

<style>
  .started {
    padding-block: 0 var(--space-section);
  }

  /* ---- The photo, from edge to edge of the window ---- */
  .started__photo {
    margin: 0;
  }
  .started__window {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--ink);
  }
  .started__inner {
    position: absolute;
    inset: 0;
  }
  .started__inner :global(.started__img),
  .started__inner :global(picture),
  .started__inner :global(img) {
    width: 100%;
    height: 100%;
  }
  .started__inner :global(img) {
    object-fit: cover;
    /* Keep the table and the faces in frame when the 4:3 photo is cropped to 16:9. */
    object-position: 50% 58%;
  }
  .started__caption {
    margin-top: 16px;
    align-items: baseline;
  }
  .started__caption-text {
    grid-column: 1 / span 8;
  }

  .started__head {
    margin-top: var(--space-section);
    margin-bottom: clamp(56px, 7vw, 112px);
  }
  .started__head :global(.started__title) {
    grid-column: 1 / -1;
  }

  /* ---- The strip of cards ---- */
  .strip__bar {
    row-gap: 0;
    align-items: baseline;
    margin-bottom: clamp(28px, 3vw, 44px);
  }
  .strip__bar :global(.strip__rule) {
    grid-column: 1 / -1;
    margin-bottom: clamp(20px, 2vw, 28px);
  }
  .strip__label {
    grid-column: 1 / span 6;
    font-weight: var(--fw-light);
  }
  .strip__toggle {
    grid-column: 7 / -1;
    justify-self: end;
    min-height: 24px;
    padding: 6px 8px;
    border: 1px solid currentColor;
  }

  /* Without motion: a row that scrolls sideways on its own, snapping to each card. */
  .strip__viewport {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--margin);
    scrollbar-width: none;
    /* Room for the cards' 3D flip, which would otherwise be clipped at the top. */
    padding-block: 2px;
  }
  .strip__viewport::-webkit-scrollbar {
    display: none;
  }
  .strip__viewport:focus-visible {
    outline-offset: -2px;
  }
  .strip__track {
    display: flex;
    gap: var(--gutter);
    width: max-content;
    padding-inline: var(--margin);
  }

  /* With motion on (about-started.js adds "is-live"), the strip is moved by the motion code
     instead of scrolled, and the cards turn in 3D, so the row gets depth. */
  .strip:global(.is-live) .strip__viewport {
    overflow: hidden;
    scroll-snap-type: none;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
  .strip:global(.is-live.is-dragging) .strip__viewport {
    cursor: grabbing;
  }
  .strip:global(.is-live) .strip__track {
    perspective: 1400px;
    will-change: transform;
  }

  /* One card: the month large at the top, the year beside it, its line at the bottom. */
  .card {
    --card-w: clamp(250px, 25.5vw, 400px);
    position: relative;
    flex: none;
    width: var(--card-w);
    aspect-ratio: 4 / 5;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(20px, 2vw, 32px);
    background: #e9e7e1;
    color: var(--ink);
    scroll-snap-align: start;
    transform-origin: 50% 100%;
  }
  .card--ink {
    background: var(--ink);
    color: var(--paper);
  }
  .card__top {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  /* The month at the site's figure size (--fs-figure, like the numbers on the home page), never
     smaller than 64px so it stays big on phones. */
  .card__month {
    font-size: max(var(--fs-figure), 64px);
    line-height: 0.8;
    letter-spacing: -0.05em;
  }
  .card__year {
    margin-top: 0.3em;
  }
  .card__index {
    position: absolute;
    top: clamp(20px, 2vw, 32px);
    right: clamp(20px, 2vw, 32px);
    color: var(--text-2, var(--ink-2));
  }
  .card__text {
    max-width: 14em;
    font-size: clamp(22px, 1.95vw, 30px);
    line-height: 1.12;
    letter-spacing: -0.015em;
  }

  /* ---- The two event photos under the strip ----
     Laptops: the large photo on columns 1 to 7 and the small one on 9 to 12 (both 3:2), their
     bottom edges level; the line under the large one and the link under the small one, 16px
     below. */
  .started__event {
    margin-top: var(--space-section);
    row-gap: 16px;
  }
  .started__event-frame {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    grid-row: 1;
    align-self: end;
  }
  .started__event-frame--wide {
    grid-column: 1 / span 7;
    aspect-ratio: 3 / 2;
  }
  .started__event-frame--small {
    grid-column: 9 / -1;
    aspect-ratio: 3 / 2;
  }
  /* Both photos already have their window's shape, so nothing is cropped away. */
  .started__event-frame .started__inner :global(img) {
    object-position: 50% 50%;
  }
  .started__event-caption {
    grid-column: 1 / span 7;
    grid-row: 2;
    max-width: 46ch;
    text-wrap: balance;
  }
  .started__event-link {
    grid-column: 9 / -1;
    grid-row: 2;
    justify-self: end;
  }

  /* With motion on, the photos and the cards wait hidden until the motion code has set them up. */
  :global(html.js-motion) [data-about-open]:not(.is-open) {
    clip-path: inset(0 0 100% 0);
  }
  :global(html.js-motion) [data-about-strip]:not(.is-ready) [data-about-strip-card] {
    visibility: hidden;
  }

  /* Tablets: the wide photo on columns 1 to 5, the small one on 6 to 8. */
  @media (max-width: 1023px) {
    .started__event-frame--wide,
    .started__event-caption {
      grid-column: 1 / span 5;
    }
    .started__event-frame--small,
    .started__event-link {
      grid-column: 6 / -1;
    }
  }

  @media (max-width: 767px) {
    .started__window {
      aspect-ratio: 4 / 3;
    }
    .started__caption-text {
      grid-column: 1 / -1;
    }
    .card {
      --card-w: 72vw;
    }
    /* Phones: the wide photo across the width, the small one under it on columns 3 to 6 (12px
       below), then the line and the link, one under the other. */
    .started__event-frame--wide,
    .started__event-frame--small,
    .started__event-caption,
    .started__event-link {
      grid-row: auto;
    }
    .started__event-frame--wide,
    .started__event-caption {
      grid-column: 1 / -1;
    }
    .started__event-frame--small {
      grid-column: 3 / -1;
      /* The rows are 16px apart; this brings the small photo to 12px under the wide one. */
      margin-top: -4px;
    }
    .started__event-caption {
      margin-top: 8px;
    }
    .started__event-link {
      grid-column: 1 / -1;
      justify-self: start;
    }
  }
</style>
