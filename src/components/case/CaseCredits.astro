---
// CaseCredits.astro: who built the tool and for whom, in one sentence, then what it runs on,
// where it stands, and where to see it.
//
// 1. The sentence, in the site's big statement type with its first line pushed in, e.g.
//    "Built by Luke Ryan ’27 and Jack Weinberg ’27 for the CLC Supported Study Hall."
//    Everything in it comes from the case file: the team (students with class years, "’27"),
//    anyone with a special role in brackets ("Keke Li ’27 (first version)"), advisors after
//    "with", and the client office (offices only, never a faculty member's name). Each name links
//    to the club's developers on the About page (/about/#developers), underlined.
// 2. One small mono row: "Runs on ...", "Status ..." (for Roster Export, where Phase 2 is
//    explained) and the links: "Repository ↗", and for Pomfret Voices "Current DEI site ↗" too.
//    A case whose "repo" is null in its case file (Music Studio, under a security review) has no
//    repository link, and the Music Studio portal itself is never linked.
// Motion: the sentence rises line by line (M1, from Statement.astro); once it has risen, the
// underlines under the names draw in from the left (M8's line, CSS below). Links do the arrow
// swap (M7).
import Statement from '../Statement.astro';
import Divider from '../Divider.astro';
import ArrowLink from '../ArrowLink.astro';
import { formatPerson, joinNames } from '../../lib/people';

interface Props {
  team: { name: string; classYear?: number; role?: string }[];
  office: string;
  // How the office reads inside the sentence (see src/content.config.ts), e.g. "teaching faculty".
  officeIn?: string;
  runsOn: string[];
  status: string;
  rows: { key: string; value: string }[];
  repo: string | null;
  liveUrl?: string;
}
const { team, office, officeIn, runsOn, status, rows, repo, liveUrl } = Astro.props;

// Where every name links: the list of the club's developers on the About page.
const DEVELOPERS = '/about/#developers';

// Sort the team into the people who built it and the people who advised on it. A role other
// than an advisor's is shortened for the brackets: "Built the first version" becomes
// "first version".
const isAdvisor = (person: { role?: string }) => Boolean(person.role && /advis/i.test(person.role));
const credit = (person: { name: string; classYear?: number; role?: string }) => ({
  name: formatPerson(person),
  note: person.role ? person.role.replace(/^built the\s+/i, '') : '',
});
const builders = team.filter((person) => !isAdvisor(person)).map(credit);
const advisors = team.filter(isAdvisor).map(credit);
const forWhom = officeIn ?? `the ${office}`;

// The sentence, as a list of pieces: plain text, or a name with its link. Names are joined like
// "A, B and C". For Roster Export it reads: "Built by James Lake ’27, Magnus Songhurst ’28 and
// Keke Li ’27 (first version), with Jay Youm ’26 (Alumni advisor), for teaching faculty."
type Piece = { text: string; href?: string };
const listOf = (people: { name: string; note: string }[]): Piece[] =>
  people.flatMap((person, i) => [
    ...(i > 0 ? [{ text: i === people.length - 1 ? ' and ' : ', ' }] : []),
    { text: person.name, href: DEVELOPERS },
    ...(person.note ? [{ text: ` (${person.note})` }] : []),
  ]);
const sentence: Piece[] = [
  { text: 'Built by ' },
  ...listOf(builders),
  ...(advisors.length ? [{ text: ', with ' }, ...listOf(advisors), { text: ',' }] : []),
  { text: ` for ${forWhom}.` },
];

// The Status row of the case file says it best when there is one; otherwise use the short status.
const statusRow = rows.find((row) => /^status$/i.test(row.key.trim()));
const statusText = statusRow ? statusRow.value : `${status}.`;
---

<section class="credits theme-paper" aria-labelledby="credits-title">
  <h2 id="credits-title" class="sr-only">Credits</h2>
  <div class="credits__grid grid">
    {
      builders.length > 0 && (
        <Statement class="credits__sentence">
          {sentence.map((piece) => (piece.href ? <a class="credits__name" href={piece.href}>{piece.text}</a> : piece.text))}
        </Statement>
      )
    }

    <Divider class="credits__rule" />
    <!-- The facts row: what it runs on, where it stands, and the links. -->
    <ul class="credits__facts t-mono">
      {
        runsOn.length > 0 && (
          <li class="credits__fact">
            <span class="credits__key">Runs on</span> {joinNames(runsOn)}.
          </li>
        )
      }
      <li class="credits__fact">
        <span class="credits__key">Status</span> {statusText}
      </li>
      {
        (liveUrl || repo) && (
          <li class="credits__fact credits__links">
            {liveUrl && (
              <ArrowLink href={liveUrl} external>
                Current DEI site
              </ArrowLink>
            )}
            {repo && (
              <ArrowLink href={repo} external>
                Repository
              </ArrowLink>
            )}
          </li>
        )
      }
    </ul>
  </div>
</section>

<style>
  .credits {
    padding-block: var(--space-section);
  }
  .credits__grid {
    row-gap: 0;
  }
  .credits__grid > :global(.credits__sentence) {
    grid-column: 1 / -1;
    margin-bottom: clamp(48px, 6vw, 96px);
  }
  .credits__grid > :global(.credits__rule) {
    grid-column: 1 / -1;
  }

  /* The names: plain links with a 1px line under them, like RollLink's underline (M8): on hover
     the line wipes out to the right and a new one draws in from the left 0.15s later. A name
     never breaks across two lines. */
  .credits__name {
    position: relative;
    white-space: nowrap;
  }
  /* The line below replaces the statement's usual text underline (on the link and, once the
     sentence is split into words, on each word). */
  .credits :global(.statement) .credits__name,
  .credits :global(.statement) .credits__name :global(.split-word) {
    text-decoration: none;
  }
  .credits__name::before,
  .credits__name::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.04em;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform var(--dur-underline) var(--ease-underline);
  }
  .credits__name::before {
    transform: scaleX(1);
    transform-origin: 100% 50%;
  }
  /* With motion on, the lines wait until the sentence has risen (reveal-lines.js adds
     "is-revealed"), then draw in from the left. */
  :global(html.js-motion) :global(.credits__sentence:not(.is-revealed)) .credits__name::before {
    transform: scaleX(0);
    transform-origin: 0 50%;
  }
  @media (hover: hover) {
    .credits__name:hover::before,
    .credits__name:focus-visible::before {
      transform: scaleX(0);
    }
    .credits__name:hover::after,
    .credits__name:focus-visible::after {
      transform: scaleX(1);
      transition-delay: 0.15s;
    }
  }

  /* The facts row: small mono capitals, the three facts side by side on wide screens, one under
     the other on phones. The small keys ("Runs on", "Status") are in the secondary color. */
  .credits__facts {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 12px;
    padding-top: 16px;
    list-style: none;
  }
  .credits__fact {
    grid-column: span 4;
  }
  .credits__key {
    color: var(--text-2);
    margin-right: 0.6em;
  }
  .credits__links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 28px;
    justify-content: flex-end;
    align-items: baseline;
  }
  @media (max-width: 1023px) {
    .credits__fact {
      grid-column: 1 / -1;
    }
    .credits__links {
      justify-content: flex-start;
    }
  }
</style>
